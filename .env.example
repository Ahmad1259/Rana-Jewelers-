# Physical Location
VITE_STORE_ADDRESS="DHA Main Boulevard, Lahore, Pakistan"
VITE_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3403.011883652618!2d74.37894!3d31.47895!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39190666016e0939%3A0x7d02e67a57a877cf!2sMain%20Blvd%2C%20DHA%20Phase%206%2C%20Lahore%2C%20Punjab%2C%20Pakistan!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s"

